# Requis en production (min. 32 caractères) — vérification CSRF des formulaires
# openssl rand -base64 32
CSRF_SECRET=

# URL publique du site (https://…) — métadonnées, Open Graph, aperçu des liens
# NEXT_PUBLIC_SITE_URL=https://exemple.fr

# Mode « bientôt disponible » : page dédiée + redirection (sauf /admin, /api, /auth, assets).
# Activer : 1, true, on, yes | Désactiver : 0, false, off, no, ou laisser vide
# NEXT_PUBLIC_COMING_SOON=1
# COMING_SOON=1

# Voir le README ou la doc interne pour DATABASE_URL, AUTH_*, RESEND_*, etc.
